generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Page {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  blocks    Block[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Block {
  id      String @id @default(uuid())
  type    String   // "header" | "paragraph" | "list" | "table" | "equation" | "docs"
  data    Json     // shape depends on type
  order   Int
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId  String
}